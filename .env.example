# Postgres with pgvector (docker compose sets this for you)
DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk@localhost:5432/helpdesk
# anthropic | openai  (openai = any OpenAI-compatible endpoint: OpenAI, OpenRouter, vLLM, Ollama)
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# Services the agent may health-check: name=url, comma separated (http(s):// or tcp://host:port)
SERVICES=api=http://localhost:8000/healthz,database=tcp://localhost:5432
MAX_STEPS=6
